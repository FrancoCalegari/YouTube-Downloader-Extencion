# ========================================================
# YOUTUBE DOWNLOADER & CONVERTER - VARIABLES DE ENTORNO (.env.example)
# Copia este archivo como .env para personalizar tu configuración
# ========================================================

PORT=23458
DOWNLOADS_DIR=./downloads
FILE_TTL_MINUTES=10

# Modo de depuración
DEBUG=true
DEBUG_LEVEL=verbose

# Clientes de reproducción de YouTube para evitar "HTTP Error 403: Forbidden"
YTDLP_PLAYER_CLIENTS=android,ios,web

# Extracción de cookies (opcional)
# YTDLP_COOKIES_BROWSER=chrome
# YTDLP_COOKIE_FILE=./cookies.txt
